---
import Layout from '../layouts/Layout.astro';

const artists = [
  { name: 'David Reyes',     handle: '@davidreyesart',       ig: 'https://www.instagram.com/davidreyesart',       slug: '/davidreyes', specialty: 'Black & Grey Realism',  avatar: '/images/avatars/david.jpg',    num: '01' },
  { name: 'Ari Reyes',       handle: '@aryatari',            ig: 'https://www.instagram.com/aryatari',            slug: '/aryatari',   specialty: 'Illustrative · Fine Line', avatar: '/images/avatars/ari.jpg',      num: '02' },
  { name: 'Joshua Reyes',    handle: '@jousoytuartista',     ig: 'https://www.instagram.com/jousoytuartista',     slug: '/joshua',     specialty: 'Black & Grey · Realism',   avatar: '/images/avatars/joshua.jpg',   num: '03' },
  { name: 'Armando Brignoni',handle: '@brignoni.arts',       ig: 'https://www.instagram.com/brignoni.arts',       slug: '/brignoni',   specialty: 'Neo-Traditional',          avatar: '/images/avatars/brignoni.jpg', num: '04' },
  { name: 'Tatito',          handle: '@tatitobodypiercings', ig: 'https://www.instagram.com/tatitobodypiercings', slug: '/piercings',  specialty: 'Body Piercing',            avatar: '/images/avatars/tatito.jpg',   num: '05' },
];

const reviews = [
  { text: '"The best in P.R — incredible work and a super clean studio."',                                          author: 'Roberto N.',   stars: 5 },
  { text: '"Great receptionist and an amazing experience from start to finish."',                                  author: 'Alex M.',      stars: 5 },
  { text: '"La experiencia fue maravillosa. Desde la llegada te tratan con cariño y respeto."',                   author: 'Isabel L.',    stars: 5 },
  { text: '"Best of the best — would definitely recommend for anyone visiting PR!"',                              author: 'Christian V.', stars: 5 },
];
---

<Layout>

  <!-- ══════════════════════════════════════════════ HERO -->
  <section class="hero" aria-label="Sacred Pain Tattoo">
    <div class="hero-media">
      <img
        src="/images/hero.jpeg"
        alt="Sacred Pain Tattoo Studio — San Juan, Puerto Rico"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-layout">
      <!-- Top left: eyebrow -->
      <div class="hero-eyebrow" data-reveal="fade">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        San Juan, Puerto Rico &nbsp;·&nbsp; Est. 2010
      </div>

      <!-- Bottom left: Giant headline -->
      <div class="hero-title-wrap">
        <h1 class="hero-title" data-reveal="up">
          <span class="ht-line">SACRED</span>
          <span class="ht-line ht-gold">PAIN</span>
        </h1>
        <p class="hero-services" data-reveal="fade">
          Tattoo &nbsp;&nbsp;·&nbsp;&nbsp; Piercing &nbsp;&nbsp;·&nbsp;&nbsp; Laser
        </p>
      </div>

      <!-- Bottom right: CTA block -->
      <div class="hero-cta-block" data-reveal="fade">
        <a class="hero-cta-btn" href="/reservar">
          Reservar cita
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <div class="hero-rating">
          <span class="hero-stars">★★★★★</span>
          <span class="hero-rating-text">4.8 &nbsp;·&nbsp; 187+ reseñas Google</span>
        </div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="scroll-cue hero-scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="scroll-cue-line"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-track" aria-hidden="true">
    <div class="marquee-inner">
      {[1, 2].map(() => (
        <>
          <span class="marquee-item">Arte Permanente</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Tattoos</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Piercings</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Laser</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Sacred Pain</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">San Juan, PR</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Walk-ins Welcome</span><span class="marquee-sep">✦</span>
          <span class="marquee-item">Artistas Premiados</span><span class="marquee-sep">✦</span>
        </>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════ INFO BAR -->
  <section class="info-section" aria-label="Información del estudio">
    <div class="container">
      <div class="info-bar">
        <div class="info-item">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <span><strong>Lun–Sáb</strong> 11 AM – 8 PM &nbsp;·&nbsp; <strong>Dom</strong> Cerrado</span>
        </div>
        <div class="info-item">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <a href="https://www.google.com/maps/dir/?api=1&destination=Sacred+Pain+Tattoo+418+Av+65+Infanteria+San+Juan+PR+00926" target="_blank" rel="noreferrer" class="info-link">
            418 Av 65 Infantería, San Juan PR
          </a>
          <a href="https://www.google.com/maps/dir/?api=1&destination=Sacred+Pain+Tattoo+418+Av+65+Infanteria+San+Juan+PR+00926" target="_blank" rel="noreferrer" class="maps-pill">
            <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            Cómo llegar
          </a>
        </div>
        <div class="info-item">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92V20a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 4.37 6.18 2 2 0 0 1 6.36 4h3.08a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L10.91 11.4a16 16 0 0 0 6.69 6.69l.78-.78a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:7875962562" class="info-link">(787) 596-2562</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider-solid" />

  <!-- ════════════════════════════════════════ SERVICIOS -->
  <section class="section-lg" id="servicios" aria-label="Nuestros servicios">
    <div class="container">
      <div class="services-header" data-reveal="up">
        <p class="kicker">Lo que hacemos</p>
        <h2 class="h2 services-title">Arte que permanece<br/><em>para siempre</em></h2>
      </div>
    </div>

    <div class="services-panels">
      <a class="svc-panel" href="/tattoos" data-reveal="fade">
        <div class="svc-img-wrap">
          <img src="/images/artist-david.jpeg" alt="Tattoos — Sacred Pain" loading="lazy" />
        </div>
        <div class="svc-overlay">
          <div class="svc-num">01</div>
          <div class="svc-info">
            <h3 class="svc-name">Tattoos</h3>
            <p class="svc-desc">Black & Grey · Realism · Neo-Traditional · Illustrative</p>
            <span class="svc-link">Ver artistas <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </div>
      </a>

      <a class="svc-panel" href="/piercings" data-reveal="fade" style="transition-delay:100ms">
        <div class="svc-img-wrap">
          <img src="/images/piercing-1.jpg" alt="Piercings — Sacred Pain" loading="lazy" />
        </div>
        <div class="svc-overlay">
          <div class="svc-num">02</div>
          <div class="svc-info">
            <h3 class="svc-name">Piercings</h3>
            <p class="svc-desc">Joyería de titanio · Ambiente estéril · Expertos certificados</p>
            <span class="svc-link">Ver precios <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </div>
      </a>

      <a class="svc-panel" href="/laser" data-reveal="fade" style="transition-delay:200ms">
        <div class="svc-img-wrap">
          <img src="/images/laser.jpeg" alt="Remoción Laser — Sacred Pain" loading="lazy" />
        </div>
        <div class="svc-overlay">
          <div class="svc-num">03</div>
          <div class="svc-info">
            <h3 class="svc-name">Laser</h3>
            <p class="svc-desc">Remoción segura · Plan de sesiones · Evaluación gratuita</p>
            <span class="svc-link">Más información <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <hr class="divider" />

  <!-- ══════════════════════════════════════════ ARTISTAS -->
  <section class="section-lg" id="equipo" aria-label="Nuestros artistas">
    <div class="container">
      <div class="artists-header" data-reveal="up">
        <div>
          <p class="kicker">El equipo</p>
          <h2 class="h2">Los artistas detrás<br/>de Sacred Pain</h2>
        </div>
        <a class="artists-all" href="/tattoos">
          Ver todos
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Horizontal scroll reel -->
    <div class="artists-reel reel" role="list" aria-label="Artistas del estudio">
      {artists.map(a => (
        <a class="artist-slide" href={a.slug} role="listitem" data-cursor>
          <div class="artist-slide-img">
            <img src={a.avatar} alt={`${a.name} — ${a.specialty}`} loading="lazy" />
          </div>
          <div class="artist-slide-info">
            <span class="artist-slide-num">{a.num}</span>
            <h3 class="artist-slide-name">{a.name}</h3>
            <p class="artist-slide-spec">{a.specialty}</p>
            <span class="artist-slide-ig">{a.handle}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <!-- ═══════════════════════════════════════════ RESEÑAS -->
  <section class="section-lg" id="reviews" aria-label="Reseñas de clientes">
    <div class="container">
      <div class="reviews-head" data-reveal="up">
        <div>
          <p class="kicker">Reseñas verificadas</p>
          <h2 class="h2">Lo que dicen<br/>nuestros clientes</h2>
        </div>
        <a
          class="trust-badge"
          href="https://maps.google.com/maps?cid=9668360326715706334"
          target="_blank"
          rel="noreferrer"
          aria-label="Ver reseñas en Google — 4.8 de 5 estrellas"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <div>
            <div class="trust-score-row">
              <span class="trust-badge-score">4.8</span>
              <span class="trust-badge-stars">★★★★★</span>
            </div>
            <span class="trust-badge-meta">187+ reseñas en Google</span>
          </div>
        </a>
      </div>

      <div class="reviews-grid" data-stagger>
        {reviews.map(r => (
          <blockquote class="review-item">
            <div class="stars" aria-label={`${r.stars} de 5 estrellas`}>{'★'.repeat(r.stars)}</div>
            <p class="review-text">{r.text}</p>
            <cite class="review-author">{r.author}</cite>
          </blockquote>
        ))}
      </div>

      <div class="reviews-ctas" data-reveal="fade">
        <a class="btn btn-outline-gold" href="https://maps.google.com/maps?cid=9668360326715706334" target="_blank" rel="noreferrer">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Leer reseñas en Google
        </a>
        <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination=Sacred+Pain+Tattoo+418+Av+65+Infanteria+San+Juan+PR+00926" target="_blank" rel="noreferrer">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Cómo llegar
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ════════════════════════════════════════ BOOKING CTA -->
  <section class="booking-section" id="reservar" aria-label="Reservar cita">
    <div class="booking-inner">
      <div class="booking-text" data-reveal="up">
        <p class="kicker">Agenda ahora</p>
        <h2 class="booking-headline">¿Listo para tu<br/><em>próxima pieza?</em></h2>
        <p class="lead booking-lead">
          Reserva con cualquiera de nuestros artistas. Walk-ins bienvenidos.
          Tattoo Now, Pay in 4 con Klarna.
        </p>
        <ul class="booking-features" aria-label="Beneficios">
          <li>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Tatuajes a medida · Walk-ins disponibles
          </li>
          <li>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Tattoo Now, Pay in 4 — auspiciado por Klarna
          </li>
          <li>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Estudio limpio, seguro y certificado
          </li>
        </ul>
      </div>
      <div class="booking-actions" data-stagger>
        <a class="btn btn-gold booking-btn-primary" href="/reservar">
          Reservar cita
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="btn" href="tel:7875962562">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M22 16.92V20a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 4.37 6.18 2 2 0 0 1 6.36 4h3.08a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L10.91 11.4a16 16 0 0 0 6.69 6.69l.78-.78a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Llamar al estudio
        </a>
        <a class="btn btn-klarna" href="/pagosaplazos">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          Pay in 4 con Klarna
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ════════════════════════════════════════════ SOCIAL -->
  <section class="social-section" id="social" aria-label="Síguenos en redes sociales">
    <div class="container">
      <div class="social-inner" data-reveal="up">
        <div class="social-text">
          <p class="kicker">Síguenos</p>
          <h2 class="h2">@sacredpain</h2>
          <p class="lead">El trabajo más reciente, behind-the-scenes y flash disponible.</p>
        </div>
        <div class="social-links" data-stagger>
          <a class="social-btn social-ig" href="https://www.instagram.com/sacredpain" target="_blank" rel="noreferrer" aria-label="Seguir en Instagram">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>
            Instagram
          </a>
          <a class="social-btn social-tt" href="https://www.tiktok.com/@sacredpain" target="_blank" rel="noreferrer" aria-label="Seguir en TikTok">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.79a4.85 4.85 0 0 1-1.02-.1z"/></svg>
            TikTok
          </a>
          <a class="social-btn social-fb" href="https://www.facebook.com/sacred.pain" target="_blank" rel="noreferrer" aria-label="Seguir en Facebook">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            Facebook
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ══ HERO ═══════════════════════════════════════════════ */
  .hero {
    position: relative;
    height: 100dvh;
    min-height: 620px;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(5,4,5,0.55) 0%, transparent 25%),
      linear-gradient(to top, rgba(5,4,5,1) 0%, rgba(5,4,5,0.65) 40%, transparent 70%),
      linear-gradient(to right, rgba(5,4,5,0.5) 0%, transparent 60%);
  }
  .hero-layout {
    position: relative;
    z-index: 2;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: 1fr auto auto;
    padding: 100px var(--pad) 56px;
    gap: 0 32px;
  }

  /* Eyebrow */
  .hero-eyebrow {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(240,236,230,0.42);
    transition-delay: 200ms;
  }
  .eyebrow-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
    animation: pulse 2.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.7); }
  }

  /* Title */
  .hero-title-wrap {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(88px, 17vw, 220px);
    line-height: 0.87;
    letter-spacing: -2px;
    margin-bottom: 18px;
    text-transform: uppercase;
  }
  .ht-line { display: block; }
  .ht-gold { color: var(--gold); }
  .hero-services {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(240,236,230,0.38);
    padding-bottom: 8px;
    transition-delay: 400ms;
  }

  /* CTA block */
  .hero-cta-block {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    padding-bottom: 8px;
    transition-delay: 300ms;
  }
  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border: 1px solid rgba(185,138,55,0.6);
    color: var(--text);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: background 0.3s var(--ease-out-expo),
                color 0.3s,
                border-color 0.3s;
    white-space: nowrap;
  }
  .hero-cta-btn:hover {
    background: var(--gold);
    color: #050405;
