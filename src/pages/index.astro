---
import Layout from '../layouts/Layout.astro';

const artists = [
  { name: 'David Reyes',     handle: '@davidreyesart',       ig: 'https://www.instagram.com/davidreyesart',       slug: '/davidreyes', specialty: 'Black & Grey Realism', avatar: '/images/avatars/david.jpg' },
  { name: 'Ari Reyes',       handle: '@aryatari',            ig: 'https://www.instagram.com/aryatari',            slug: '/aryatari',   specialty: 'Illustrative',      avatar: '/images/avatars/ari.jpg' },
  { name: 'Joshua Reyes',    handle: '@jousoytuartista',     ig: 'https://www.instagram.com/jousoytuartista',     slug: '/joshua',     specialty: 'Black & Grey',      avatar: '/images/avatars/joshua.jpg' },
  { name: 'Armando Brignoni',handle: '@brignoni.arts',       ig: 'https://www.instagram.com/brignoni.arts',       slug: '/brignoni',   specialty: 'Neo-traditional',   avatar: '/images/avatars/brignoni.jpg' },
];

const reviews = [
  { text: 'A premium experience unlike any standard tattoo shop. Absolute perfection.', author: 'Roberto N.' },
  { text: 'The atmosphere is incredible. You feel the art the moment you walk in.', author: 'Alex M.' },
];
---

<Layout>
  <!-- ════════════════════════════════════════════════ HERO (VIDEO LOOP) -->
  <section class="relative h-screen w-full overflow-hidden flex items-center justify-center bg-background">
    <!-- Video Background -->
    <video
      autoplay
      loop
      muted
      playsinline
      disablePictureInPicture
      disableRemotePlayback
      class="absolute inset-0 w-full h-full object-cover opacity-40 scale-105 pointer-events-none"
    >
      <source src="/videos/tour.mp4" type="video/mp4" />
    </video>
    
    <!-- Cyberpunk Gradients & Overlays -->
    <div class="absolute inset-0 bg-hero-gradient pointer-events-none"></div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[600px] h-[300px] sm:h-[600px] bg-neon/10 rounded-full blur-[80px] sm:blur-[120px] pointer-events-none mix-blend-screen"></div>

    <!-- Brutalist Hero Content -->
    <div class="relative z-10 container-brutal w-full flex flex-col items-center text-center mt-12 sm:mt-20">
      <div class="overflow-hidden mb-4 sm:mb-6">
        <p class="text-neon tracking-[0.2em] sm:tracking-super-wide text-[10px] sm:text-xs font-bold uppercase fade-up" style="transition-delay: 100ms;">High-end Studio · San Juan</p>
      </div>
      
      <div class="flex flex-col gap-0 mb-6 sm:mb-10 items-center">
        <!-- Cursive Handwriting (Matches physical sign) -->
        <h1 class="text-[25vw] sm:text-[14vw] md:text-[11vw] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 fade-up drop-shadow-2xl translate-y-6 sm:translate-y-4" style="font-family: 'Great Vibes', cursive; transition-delay: 200ms; line-height: 1.1; margin-bottom: -15px;">
          Sacred Pain
        </h1>
        <!-- Brutalist Accent -->
        <h2 class="text-[14vw] sm:text-[10vw] md:text-[8vw] font-display font-bold uppercase tracking-tighter text-white/95 fade-up truncate px-2 sm:px-4" style="transition-delay: 300ms; line-height: 0.9;">
          <span class="text-neon/80 italic text-[11vw] sm:text-[9vw] md:text-[7vw]">Tattoo</span>
        </h2>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full max-w-sm sm:max-w-none fade-up" style="transition-delay: 400ms;">
        <a href="/reservar" class="btn-brutal-neon w-full sm:w-auto text-center">Reservar Cita</a>
        <a href="#artistas" class="btn-brutal w-full sm:w-auto text-center">Explorar Galería</a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 fade-up hidden sm:flex" style="transition-delay: 600ms;">
      <span class="text-[10px] tracking-widest uppercase rotate-90 mb-4">Scroll</span>
      <div class="w-px h-16 bg-gradient-to-b from-white to-transparent"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ MARQUEE (BRUTALIST THICK) -->
  <div class="border-y border-white/5 bg-black py-4 overflow-hidden relative z-10 flex">
    <div class="flex whitespace-nowrap animate-[marquee_20s_linear_infinite] items-center gap-8">
      {[...Array(4)].map(() => (
        <>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">TATTOOS</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">PIERCINGS</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">LASER</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">SACRED PAIN</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">WALK-INS WELCOME</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">SAN JUAN, PR</span>
          <span class="text-neon">✦</span>
        </>
      ))}
    </div>
  </div>

  <!-- ════════════════════════════════════════ THE EXPERIENCE (GLASSMORPHISM) -->
  <section class="py-32 relative bg-background">
    <!-- Background Grid -->
    <div class="absolute inset-0 grid-lines grid-lines-v opacity-30 pointer-events-none"></div>

    <div class="container-brutal">
      <div class="grid md:grid-cols-2 gap-16 md:gap-8 items-center">
        <div class="fade-up relative text-center md:text-left">
          <div class="hidden md:block absolute -left-4 -top-4 w-24 h-24 border-l border-t border-neon opacity-50"></div>
          <h2 class="text-5xl sm:text-7xl font-display font-bold mb-4 sm:mb-6 leading-[0.9] sm:leading-tight">Redefining<br/><span class="text-muted">Body Art</span></h2>
          <p class="text-base sm:text-lg text-muted max-w-sm sm:max-w-md mx-auto md:mx-0 mb-8 leading-relaxed">
            Not just a shop. An immersive experience tailored for those who demand absolute perfection. Step into the void, leave with a masterpiece.
          </p>
          <a href="/tattoos" class="inline-flex items-center text-neon uppercase tracking-widest text-sm font-bold group">
            Ver Portafolio
            <svg class="ml-2 w-5 h-5 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>

        <div class="relative fade-up glass-panel p-2 mt-8 md:mt-0">
          <video autoplay loop muted playsinline disablePictureInPicture disableRemotePlayback class="w-full aspect-square object-cover grayscale opacity-80 mix-blend-screen scale-[0.98] hover:scale-100 hover:grayscale-0 transition-all duration-700 pointer-events-none">
            <!-- El usuario deberá colocar su video aquí -->
            <source src="/videos/tour.mp4" type="video/mp4" />
          </video>
          <div class="absolute bottom-6 right-6 bg-black/80 backdrop-blur border border-white/10 px-4 sm:px-6 py-2 sm:py-3">
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-white/70">Est. 2012</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PARALLAX ARTISTS (BRUTALIST GRID) -->
  <section id="artistas" class="py-32 bg-surface relative border-t border-white/5">
    <div class="container-brutal">
      <div class="flex flex-col md:flex-row justify-between items-center md:items-end mb-16 sm:mb-20 fade-up text-center md:text-left gap-6">
        <div>
          <h2 class="text-5xl sm:text-8xl font-display font-bold uppercase tracking-tighter">The<br class="hidden sm:block"/>Artists</h2>
        </div>
        <p class="text-muted text-[11px] sm:text-sm max-w-[280px] sm:max-w-xs uppercase tracking-widest sm:text-right border-t sm:border-t-0 sm:border-l border-white/10 pt-4 sm:pt-0 sm:pl-6 sm:h-full">
          Award winning talent. Specializing in high-end realism and neo-traditional.
        </p>
      </div>

      <!-- Asymmetric Parallax Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-y-12 sm:gap-x-12 md:gap-x-8 md:gap-y-16">
        {artists.map((artist, idx) => (
          <div class={`fade-up group relative md:col-span-5 ${idx % 2 !== 0 ? 'md:col-start-8 md:mt-32' : ''}`}>
            <!-- Image Card -->
            <a href={artist.slug} class="block hover-reveal-image group glass-panel p-2">
              <div class="relative aspect-[3/4] overflow-hidden bg-black">
                <img src={artist.avatar} alt={artist.name} class="w-full h-full object-cover opacity-80" loading="lazy" />
                
                <!-- Hover Cyberpunk Overlay -->
                <div class="absolute inset-0 border-2 border-neon opacity-0 group-hover:opacity-100 scale-[0.98] transition-all duration-500 pointer-events-none"></div>
                <div class="absolute inset-0 bg-neon/10 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
              </div>
            </a>
            
            <!-- Brutalist Meta -->
            <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row justify-between items-center sm:items-start text-center sm:text-left gap-2 sm:gap-0">
              <div>
                <h3 class="text-2xl sm:text-3xl font-display font-bold uppercase mb-1">{artist.name}</h3>
                <p class="text-neon text-[10px] sm:text-xs tracking-widest uppercase">{artist.specialty}</p>
              </div>
              <a href={artist.ig} target="_blank" class="text-muted hover:text-white transition-colors">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ BOOKING CTA (CYBERPUNK NEON) -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-neon/5 pointer-events-none"></div>
    <div class="container-brutal text-center fade-up relative z-10">
      <h2 class="text-6xl sm:text-[8vw] font-display font-bold uppercase leading-none mb-8">
        Secure Your <br/> <span class="text-transparent" style="-webkit-text-stroke: 1px rgba(222, 250, 0, 0.8);">Session</span>
      </h2>
      <p class="text-muted text-lg mb-12 max-w-xl mx-auto">
        Walk-ins welcome, but appointments guarantee your spot with our premium artists. Powered by Klarna Pay in 4.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a href="/reservar" class="btn-brutal-neon w-full sm:w-auto">Book Now</a>
        <a href="/pagosaplazos" class="btn-brutal w-full sm:w-auto relative group overflow-hidden">
          <span class="relative z-10">Pay Later Info</span>
          <div class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Mobile Autoplay Fix for iOS Low Power Mode -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const videos = document.querySelectorAll("video");
      
      const playVideos = () => {
        videos.forEach((video) => {
          video.muted = true;
          video.setAttribute('playsinline', '');
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Browser blocked autoplay (likely Low Power Mode), wait for interaction
              console.log("Autoplay blocked, waiting for interaction.");
            });
          }
        });
      };

      // Try playing immediately
      playVideos();

      // Fallback: force play on the absolute first touch/click anywhere on the screen
      const unlockVideos = () => {
        playVideos();
        document.body.removeEventListener('touchstart', unlockVideos);
        document.body.removeEventListener('click', unlockVideos);
      };

      document.body.addEventListener('touchstart', unlockVideos, { once: true });
      document.body.addEventListener('click', unlockVideos, { once: true });
    });
  </script>
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
