---
import Layout from '../layouts/Layout.astro';

const artists = [
  { name: 'David Reyes',     handle: '@davidreyesart',       ig: 'https://www.instagram.com/davidreyesart',       slug: '/davidreyes', specialty: 'Black & Grey Realism', avatar: '/images/avatars/david.jpg' },
  { name: 'Ari Reyes',       handle: '@aryatari',            ig: 'https://www.instagram.com/aryatari',            slug: '/aryatari',   specialty: 'Illustrative',      avatar: '/images/avatars/ari.jpg' },
  { name: 'Joshua Reyes',    handle: '@jousoytuartista',     ig: 'https://www.instagram.com/jousoytuartista',     slug: '/joshua',     specialty: 'Black & Grey',      avatar: '/images/avatars/joshua.jpg' },
  { name: 'Armando Brignoni',handle: '@brignoni.arts',       ig: 'https://www.instagram.com/brignoni.arts',       slug: '/brignoni',   specialty: 'Neo-traditional',   avatar: '/images/avatars/brignoni.jpg' },
];

const reviews = [
  { text: 'A premium experience unlike any standard tattoo shop. Absolute perfection.', author: 'Roberto N.' },
  { text: 'The atmosphere is incredible. You feel the art the moment you walk in.', author: 'Alex M.' },
];
---

<Layout>
  <!-- ════════════════════════════════════════════════ HERO (VIDEO LOOP) -->
  <section class="relative h-screen w-full overflow-hidden flex items-center justify-center bg-background">
    <!-- Video Background -->
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover opacity-40 scale-105 pointer-events-none"
    >
      <!-- El usuario deberá colocar sus videos inmersivos aquí -->
      <source src="/videos/tour.mp4" type="video/mp4" />
    </video>
    
    <!-- Cyberpunk Gradients & Overlays -->
    <div class="absolute inset-0 bg-hero-gradient pointer-events-none"></div>
    <div class="absolute inset-0 bg-black/30 pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-neon/5 rounded-full blur-[120px] pointer-events-none mix-blend-screen"></div>

    <!-- Brutalist Hero Content -->
    <div class="relative z-10 container-brutal w-full flex flex-col items-center sm:items-start text-center sm:text-left mt-20">
      <div class="overflow-hidden mb-4">
        <p class="text-neon tracking-super-wide text-xs font-bold uppercase fade-up" style="transition-delay: 100ms;">High-end Studio · San Juan</p>
      </div>
      
      <div class="flex flex-col gap-0 leading-[0.8] mb-12">
        <h1 class="text-[12vw] sm:text-[10vw] md:text-[8vw] font-display font-bold uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 fade-up" style="transition-delay: 200ms;">
          Sacred
        </h1>
        <h1 class="text-[12vw] sm:text-[10vw] md:text-[8vw] font-display font-bold uppercase tracking-tighter text-white fade-up" style="transition-delay: 300ms;">
          Pain <span class="text-neon/80 italic">Tattoo</span>
        </h1>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-6 fade-up" style="transition-delay: 400ms;">
        <a href="/reservar" class="btn-brutal-neon w-full sm:w-auto">Reservar Cita</a>
        <a href="#artistas" class="btn-brutal w-full sm:w-auto mt-4 sm:mt-0">Explorar Galería</a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 fade-up" style="transition-delay: 600ms;">
      <span class="text-[10px] tracking-widest uppercase rotate-90 mb-4">Scroll</span>
      <div class="w-px h-16 bg-gradient-to-b from-white to-transparent"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ MARQUEE (BRUTALIST THICK) -->
  <div class="border-y border-white/5 bg-black py-4 overflow-hidden relative z-10 flex">
    <div class="flex whitespace-nowrap animate-[marquee_20s_linear_infinite] items-center gap-8">
      {[...Array(4)].map(() => (
        <>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">TATTOOS</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">PIERCINGS</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">LASER</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">SACRED PAIN</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">WALK-INS WELCOME</span>
          <span class="text-neon">✦</span>
          <span class="text-4xl md:text-6xl font-display font-bold text-white">SAN JUAN, PR</span>
          <span class="text-neon">✦</span>
        </>
      ))}
    </div>
  </div>

  <!-- ════════════════════════════════════════ THE EXPERIENCE (GLASSMORPHISM) -->
  <section class="py-32 relative bg-background">
    <!-- Background Grid -->
    <div class="absolute inset-0 grid-lines grid-lines-v opacity-30 pointer-events-none"></div>

    <div class="container-brutal">
      <div class="grid md:grid-cols-2 gap-16 md:gap-8 items-center">
        <div class="fade-up relative">
          <div class="absolute -left-4 -top-4 w-24 h-24 border-l border-t border-neon opacity-50"></div>
          <h2 class="text-5xl sm:text-7xl font-display font-bold mb-6">Redefining<br/><span class="text-muted">Body Art</span></h2>
          <p class="text-lg text-muted max-w-md mb-8 leading-relaxed">
            Not just a shop. An immersive experience tailored for those who demand absolute perfection. Step into the void, leave with a masterpiece.
          </p>
          <a href="/tattoos" class="inline-flex items-center text-neon uppercase tracking-widest text-sm font-bold group">
            Ver Portafolio
            <svg class="ml-2 w-5 h-5 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>

        <div class="relative fade-up glass-panel p-2">
          <video autoplay loop muted playsinline class="w-full aspect-square object-cover grayscale opacity-80 mix-blend-screen scale-95 hover:scale-100 hover:grayscale-0 transition-all duration-700">
            <!-- El usuario deberá colocar su video aquí -->
            <source src="/videos/tour.mp4" type="video/mp4" />
          </video>
          <div class="absolute bottom-6 right-6 bg-black/80 backdrop-blur border border-white/10 px-6 py-3">
            <span class="text-xs uppercase tracking-widest text-white/70">Est. 2012</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PARALLAX ARTISTS (BRUTALIST GRID) -->
  <section id="artistas" class="py-32 bg-surface relative border-t border-white/5">
    <div class="container-brutal">
      <div class="flex flex-col md:flex-row justify-between items-end mb-20 fade-up">
        <div>
          <h2 class="text-6xl sm:text-8xl font-display font-bold uppercase tracking-tighter">The<br/>Artists</h2>
        </div>
        <p class="text-muted text-sm max-w-xs uppercase tracking-widest text-right hidden md:block border-l border-white/10 pl-6 h-full">
          Award winning talent. Specializing in high-end realism and neo-traditional.
        </p>
      </div>

      <!-- Asymmetric Parallax Grid -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-y-16 md:gap-8">
        {artists.map((artist, idx) => (
          <div class={`fade-up group relative md:col-span-5 ${idx % 2 !== 0 ? 'md:col-start-8 md:mt-32' : ''}`}>
            <!-- Image Card -->
            <a href={artist.slug} class="block hover-reveal-image group glass-panel p-2">
              <div class="relative aspect-[3/4] overflow-hidden bg-black">
                <img src={artist.avatar} alt={artist.name} class="w-full h-full object-cover opacity-80" loading="lazy" />
                
                <!-- Hover Cyberpunk Overlay -->
                <div class="absolute inset-0 border-2 border-neon opacity-0 group-hover:opacity-100 scale-[0.98] transition-all duration-500 pointer-events-none"></div>
                <div class="absolute inset-0 bg-neon/10 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>
            </a>
            
            <!-- Brutalist Meta -->
            <div class="mt-6 flex justify-between items-start">
              <div>
                <h3 class="text-3xl font-display font-bold uppercase mb-1">{artist.name}</h3>
                <p class="text-neon text-xs tracking-widest uppercase">{artist.specialty}</p>
              </div>
              <a href={artist.ig} target="_blank" class="text-muted hover:text-white transition-colors">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ BOOKING CTA (CYBERPUNK NEON) -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-neon/5 pointer-events-none"></div>
    <div class="container-brutal text-center fade-up relative z-10">
      <h2 class="text-6xl sm:text-[8vw] font-display font-bold uppercase leading-none mb-8">
        Secure Your <br/> <span class="text-transparent" style="-webkit-text-stroke: 1px rgba(222, 250, 0, 0.8);">Session</span>
      </h2>
      <p class="text-muted text-lg mb-12 max-w-xl mx-auto">
        Walk-ins welcome, but appointments guarantee your spot with our premium artists. Powered by Klarna Pay in 4.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a href="/reservar" class="btn-brutal-neon w-full sm:w-auto">Book Now</a>
        <a href="/pagosaplazos" class="btn-brutal w-full sm:w-auto relative group overflow-hidden">
          <span class="relative z-10">Pay Later Info</span>
          <div class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
