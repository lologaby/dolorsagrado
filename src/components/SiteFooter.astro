---
const year = new Date().getFullYear();

const links = [
  { href: '/tattoos',   label: 'Tattoos' },
  { href: '/piercings', label: 'Piercings' },
  { href: '/laser',     label: 'Laser Removal' },
  { href: '/reservar',  label: 'Book Session' },
  { href: '/pagosaplazos', label: 'Pay in 4' },
];

const artists = [
  { href: '/davidreyes', label: 'David Reyes' },
  { href: '/aryatari',   label: 'Ari Reyes' },
  { href: '/joshua',     label: 'Joshua Reyes' },
  { href: '/brignoni',   label: 'Armando Brignoni' },
];
---

<footer class="bg-black pt-32 pb-12 border-t border-white/5 relative overflow-hidden">
  <!-- Decorative Grid -->
  <div class="absolute inset-0 grid-lines grid-lines-v opacity-20 pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-neon/5 rounded-full blur-[120px] pointer-events-none translate-y-1/2 translate-x-1/2"></div>

  <div class="container-brutal relative z-10">
    <div class="grid md:grid-cols-12 gap-16 md:gap-8 mb-24">
      
      <!-- Brand & Massive CTA -->
      <div class="md:col-span-6 flex flex-col justify-between">
        <div>
          <h2 class="text-6xl sm:text-[7vw] font-display font-bold uppercase leading-[0.85] tracking-tighter text-white mb-6">
            Get <span class="text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.4);">Inked.</span>
          </h2>
          <a href="tel:7875962562" class="inline-block text-3xl font-display text-neon hover:text-white transition-colors duration-300">
            (787) 596-2562
          </a>
        </div>
        
        <div class="mt-16 md:mt-0">
          <p class="text-muted text-sm uppercase tracking-widest leading-relaxed max-w-sm">
            418 Av 65 Infantería<br/>
            San Juan, PR 00926<br/><br/>
            <span class="text-white">Mon–Sat</span> 11:00 – 20:00<br/>
            <span class="text-white">Sun</span> Closed
          </p>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="md:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-white/40 mb-8 border-b border-white/10 pb-4">Navigate</h3>
        <nav class="flex flex-col gap-4">
          {links.map(l => (
            <a href={l.href} class="text-lg font-display uppercase tracking-widest text-primary hover:text-neon hover:translate-x-2 transition-all duration-300">
              {l.label}
            </a>
          ))}
        </nav>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-white/40 mb-8 border-b border-white/10 pb-4">Artists</h3>
        <nav class="flex flex-col gap-4">
          {artists.map(l => (
            <a href={l.href} class="text-lg font-display uppercase tracking-widest text-primary hover:text-neon hover:translate-x-2 transition-all duration-300">
              {l.label}
            </a>
          ))}
        </nav>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-white/10">
      <div class="flex items-center gap-4">
        <a href="https://www.instagram.com/sacredpain" target="_blank" class="w-10 h-10 border border-white/20 flex items-center justify-center text-muted hover:text-neon hover:border-neon transition-colors duration-300">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.tiktok.com/@sacredpain" target="_blank" class="w-10 h-10 border border-white/20 flex items-center justify-center text-muted hover:text-neon hover:border-neon transition-colors duration-300">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.79a4.85 4.85 0 0 1-1.02-.1z"/></svg>
        </a>
      </div>
      <p class="text-[10px] uppercase tracking-widest text-white/30">
        © {year} Sacred Pain Tattoo. All Rights Reserved. Not for the weak.
      </p>
    </div>
  </div>
</footer>
