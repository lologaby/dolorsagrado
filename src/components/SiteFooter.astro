---
const year = new Date().getFullYear();

const services = [
  { href: '/tattoos',      label: 'Tattoos' },
  { href: '/piercings',    label: 'Piercings' },
  { href: '/laser',        label: 'Remoción Laser' },
  { href: '/reservar',     label: 'Reservar cita' },
  { href: '/pagosaplazos', label: 'Pagos a plazos' },
  { href: '/contacto',     label: 'Contacto' },
];

const artists = [
  { href: '/davidreyes', label: 'David Reyes' },
  { href: '/aryatari',   label: 'Ari Reyes' },
  { href: '/joshua',     label: 'Joshua Reyes' },
  { href: '/brignoni',   label: 'Armando Brignoni' },
];
---

<footer class="footer">
  <!-- Top: brand strip -->
  <div class="footer-top">
    <div class="container footer-top-inner">
      <a class="footer-logo" href="/" aria-label="Sacred Pain Tattoo — Inicio">
        <img src="/images/logo.png" alt="" width="44" height="44" aria-hidden="true" />
        <span class="footer-brand-name">Sacred Pain<br/><em>Tattoo & Piercings</em></span>
      </a>
      <a class="footer-book-btn" href="/reservar">Reservar cita</a>
    </div>
  </div>

  <hr class="divider-solid" />

  <!-- Middle: nav columns -->
  <div class="footer-mid">
    <div class="container footer-grid">
      <!-- tagline col -->
      <div class="footer-col footer-col--brand">
        <p class="footer-tagline">
          Arte permanente en San Juan, Puerto Rico.<br/>
          Artistas premiados · Ambiente certificado.
        </p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/sacredpain" target="_blank" rel="noreferrer" aria-label="Instagram" class="footer-social-link">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.tiktok.com/@sacredpain" target="_blank" rel="noreferrer" aria-label="TikTok" class="footer-social-link">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.79a4.85 4.85 0 0 1-1.02-.1z"/></svg>
          </a>
          <a href="https://www.facebook.com/sacred.pain" target="_blank" rel="noreferrer" aria-label="Facebook" class="footer-social-link">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      <!-- Servicios -->
      <div class="footer-col">
        <p class="footer-col-title">Servicios</p>
        <nav aria-label="Servicios">
          {services.map(l => <a class="footer-link" href={l.href}>{l.label}</a>)}
        </nav>
      </div>

      <!-- Artistas -->
      <div class="footer-col">
        <p class="footer-col-title">Artistas</p>
        <nav aria-label="Artistas">
          {artists.map(l => <a class="footer-link" href={l.href}>{l.label}</a>)}
        </nav>
      </div>

      <!-- Contacto -->
      <div class="footer-col">
        <p class="footer-col-title">Contacto</p>
        <a class="footer-phone" href="tel:7875962562">(787) 596-2562</a>
        <address>
          418 Av 65 Infantería<br/>
          San Juan, PR 00926
        </address>
        <p class="footer-hours">
          <strong>Lun–Sáb</strong> 11 AM – 8 PM<br/>
          <strong>Dom</strong> Cerrado
        </p>
        <a
          class="footer-maps"
          href="https://www.google.com/maps/dir/?api=1&destination=Sacred+Pain+Tattoo+418+Av+65+Infanteria+San+Juan+PR+00926"
          target="_blank"
          rel="noreferrer"
        >
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Ver en Maps
        </a>
      </div>
    </div>
  </div>

  <hr class="divider-solid" />

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">© {year} Sacred Pain Tattoo · All Rights Reserved.</p>
      <p class="footer-copy">
        <a href="tel:7875962562">(787) 596-2562</a>
        &nbsp;·&nbsp; San Juan, Puerto Rico
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    border-top: 1px solid var(--border);
  }

  /* Top strip */
  .footer-top { padding: 36px 0; }
  .footer-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .footer-logo img {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border-gold);
    object-fit: cover;
  }
  .footer-brand-name {
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 1.5px;
    color: var(--text);
    line-height: 1.2;
  }
  .footer-brand-name em {
    font-style: normal;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--muted2);
    font-family: var(--font-body);
    font-weight: 400;
    display: block;
    margin-top: 2px;
  }

  .footer-book-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border: 1px solid var(--border-gold);
    color: var(--gold);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .footer-book-btn:hover {
    background: var(--gold);
    color: #050405;
    border-color: var(--gold);
  }

  /* Middle */
  .footer-mid { padding: 48px 0; }
  .footer-grid {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 600px)  { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .footer-grid { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }

  .footer-col { display: flex; flex-direction: column; gap: 0; }
  .footer-col--brand { gap: 16px; }

  .footer-col-title {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.75;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }
  .footer-social-link {
    width: 34px; height: 34px;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: border-color 0.2s, color 0.2s;
  }
  .footer-social-link:hover { border-color: var(--gold); color: var(--gold); }

  nav { display: flex; flex-direction: column; gap: 10px; }
  .footer-link {
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .footer-link:hover { color: var(--text); }

  .footer-phone {
    display: block;
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--gold-lt);
    letter-spacing: 1px;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  .footer-phone:hover { color: var(--gold); }

  address {
    font-style: normal;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 8px;
  }
  .footer-hours {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .footer-hours strong { color: var(--text); font-weight: 500; }

  .footer-maps {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted2);
    transition: color 0.2s;
  }
  .footer-maps:hover { color: var(--gold); }

  /* Bottom */
  .footer-bottom { padding: 20px 0; }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .footer-copy {
    font-size: 11.5px;
    color: var(--muted2);
    letter-spacing: 0.3px;
  }
  .footer-copy a {
    color: var(--muted2);
    transition: color 0.2s;
  }
  .footer-copy a:hover { color: var(--muted); }
</style>
