---
const nav = [
  { href: '/',          label: 'Studio' },
  { href: '/tattoos',   label: 'Tattoos' },
  { href: '/piercings', label: 'Piercings' },
  { href: '/contacto',  label: 'Contacto' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="fixed top-0 left-0 w-full z-[200] mix-blend-difference bg-transparent transition-all duration-300 pointer-events-none" id="header">
  <div class="container-brutal py-6 md:py-8 flex items-center justify-between pointer-events-auto">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-4">
      <div class="w-12 h-12 border-2 border-primary rounded-full flex items-center justify-center group-hover:bg-primary group-hover:text-black transition-colors duration-300">
        <span class="font-display font-bold text-xl leading-none">SP</span>
      </div>
      <div class="hidden sm:flex flex-col">
        <span class="font-display text-2xl uppercase tracking-tighter leading-none">Sacred Pain</span>
        <span class="text-[9px] uppercase tracking-widest text-primary/70">San Juan, PR</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8 glass-panel px-8 py-3 rounded-full pointer-events-auto">
      {nav.map(item => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`text-xs font-display uppercase tracking-[0.2em] transition-all duration-300 hover:text-neon ${isActive ? 'text-neon' : 'text-primary'}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- CTAs & Hamburger -->
    <div class="flex items-center gap-4 pointer-events-auto">
      <a href="/reservar" class="hidden sm:inline-flex text-xs font-bold uppercase tracking-widest text-black bg-neon px-6 py-3 hover:bg-white transition-colors duration-300">
        Book
      </a>
      <button id="hamburger" class="md:hidden w-12 h-12 border border-primary/20 flex flex-col items-center justify-center gap-1.5 transition-colors hover:border-neon group" aria-label="Menu">
        <span class="w-5 h-[2px] bg-primary group-hover:bg-neon transition-all duration-300 tr-bar-1"></span>
        <span class="w-5 h-[2px] bg-primary group-hover:bg-neon transition-all duration-300 tr-bar-2"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Full Screen Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-background/95 backdrop-blur-2xl z-[190] flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-500">
  <div class="absolute inset-0 bg-noise opacity-5 pointer-events-none"></div>
  <nav class="flex flex-col gap-8 text-center relative z-10">
    {nav.map((item, idx) => {
      const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`font-display text-5xl uppercase tracking-tighter transition-all duration-300 mobile-link transform translate-y-8 opacity-0 ${isActive ? 'text-neon italic' : 'text-primary hover:text-neon hover:italic'}`}
          style={`transition-delay: ${100 + idx * 100}ms;`}
        >
          {item.label}
        </a>
      );
    })}
    <a href="/reservar" class="mt-8 btn-brutal-neon transform translate-y-8 opacity-0 mobile-link" style="transition-delay: 500ms;">
      Book Session
    </a>
  </nav>
</div>

<script>
  const btn = document.getElementById('hamburger');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');
  const bar1 = document.querySelector('.tr-bar-1');
  const bar2 = document.querySelector('.tr-bar-2');
  let open = false;

  if (btn && menu) {
    btn.addEventListener('click', () => {
      open = !open;
      if (open) {
        menu.classList.remove('opacity-0', 'pointer-events-none');
        menu.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
        
        // Transform hamburger to X
        bar1?.classList.add('translate-y-[4px]', 'rotate-45');
        bar2?.classList.add('-translate-y-[4px]', '-rotate-45');

        // Animate links in
        links.forEach(l => {
          l.classList.remove('translate-y-8', 'opacity-0');
          l.classList.add('translate-y-0', 'opacity-100');
        });
      } else {
        menu.classList.remove('opacity-100', 'pointer-events-auto');
        menu.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
        
        // Transform X to hamburger
        bar1?.classList.remove('translate-y-[4px]', 'rotate-45');
        bar2?.classList.remove('-translate-y-[4px]', '-rotate-45');

        // Animate links out
        links.forEach(l => {
          l.classList.remove('translate-y-0', 'opacity-100');
          l.classList.add('translate-y-8', 'opacity-0');
        });
      }
    });

    // Close on link click
    links.forEach(link => {
      link.addEventListener('click', () => {
        if(open) btn.click();
      });
    });
  }
</script>
